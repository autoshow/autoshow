{
  "id": "verify-image-openai-gptimage1mini",
  "name": "Verify: OpenAI GPT-Image-1-Mini",
  "description": "Minimal verification test for OpenAI GPT-Image-1-Mini image generation",
  "tags": [
    "verify",
    "image",
    "openai",
    "minimal",
    "minimal-service"
  ],
  "input": {
    "type": "local",
    "path": "scripts/test/fixtures/input/1.mp3"
  },
  "transcription": {
    "service": "groq",
    "model": "whisper-large-v3-turbo"
  },
  "llm": {
    "service": "groq",
    "model": "openai/gpt-oss-20b",
    "prompts": [
      "shortSummary"
    ]
  },
  "tts": {
    "enabled": false
  },
  "image": {
    "enabled": true,
    "service": "openai",
    "model": "gpt-image-1-mini",
    "prompts": [
      "thumbnail"
    ],
    "aspectRatio": "1024x1024"
  },
  "music": {
    "enabled": false
  },
  "video": {
    "enabled": false
  }
}
