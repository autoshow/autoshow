{
  "id": "verify-image-glm-glmimage",
  "name": "Verify: GLM Image",
  "description": "Minimal verification test for GLM image generation",
  "tags": [
    "verify",
    "image",
    "glm",
    "minimal",
    "minimal-service"
  ],
  "input": {
    "type": "local",
    "path": "scripts/test/fixtures/input/1.mp3"
  },
  "transcription": {
    "service": "groq",
    "model": "whisper-large-v3-turbo"
  },
  "llm": {
    "service": "groq",
    "model": "openai/gpt-oss-20b",
    "prompts": [
      "shortSummary"
    ]
  },
  "tts": {
    "enabled": false
  },
  "image": {
    "enabled": true,
    "service": "glm",
    "model": "glm-image",
    "prompts": [
      "thumbnail"
    ],
    "aspectRatio": "1:1"
  },
  "music": {
    "enabled": false
  },
  "video": {
    "enabled": false
  }
}
