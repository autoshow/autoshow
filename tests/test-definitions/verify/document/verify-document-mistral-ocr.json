{
  "id": "verify-document-mistral-ocr",
  "name": "Verify: Mistral OCR",
  "description": "Minimal verification test for Mistral OCR document parsing",
  "tags": [
    "verify",
    "document",
    "mistral-ocr",
    "minimal",
    "minimal-service"
  ],
  "input": {
    "type": "url",
    "url": "https://ajc.pics/autoshow/textract-1.pdf",
    "urlType": "document"
  },
  "transcription": {
    "service": "groq",
    "model": "whisper-large-v3-turbo"
  },
  "llm": {
    "service": "groq",
    "model": "openai/gpt-oss-20b",
    "prompts": [
      "shortSummary"
    ]
  },
  "document": {
    "service": "mistral-ocr",
    "model": "mistral-ocr-latest"
  },
  "tts": {
    "enabled": false
  },
  "image": {
    "enabled": false
  },
  "music": {
    "enabled": false
  },
  "video": {
    "enabled": false
  }
}
