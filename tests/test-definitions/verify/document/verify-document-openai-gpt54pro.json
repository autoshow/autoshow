  "document": {
    "service": "openai",
    "model": "gpt-5.4-pro"
  },
  "tts": {
    "enabled": false
  },
  "image": {
    "enabled": false
  },
  "music": {
    "enabled": false
  },
  "video": {
    "enabled": false
  }
