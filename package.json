{
  "name": "autoshow-bun",
  "type": "module",
  "author": "Anthony Campolo",
  "license": "MIT",
  "scripts": {
    "repo": "bash .github/repomix.sh",
    "play": "bunx playwright test",
    "check": "bunx tsc --noEmit",
    "quality": "bun run check",
    "as": "bun scripts/cli.ts",
    "cli": "bun scripts/cli.ts",
    "dev": "bun run --bun vinxi dev",
    "build": "bun run --bun vinxi build --preset bun",
    "start": "bun run --bun vinxi start --preset bun",
    "up": "bun as docker up prune"
  },
  "dependencies": {
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "0.16.1",
    "@solidjs/start": "1.3.2",
    "@valibot/to-json-schema": "1.6.0",
    "clsx": "2.1.1",
    "solid-js": "1.9.12",
    "valibot": "1.3.1",
    "vinxi": "0.5.11"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/bun": "1.3.14",
    "playwright": "1.59.1",
    "typescript": "6.0.2"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "brace-expansion": "5.0.5",
    "defu": "6.1.7",
    "express-rate-limit": "8.3.2",
    "h3": "1.15.11",
    "hono": "4.12.12",
    "lodash": "4.18.1",
    "node-forge": "1.4.0",
    "picomatch": "4.0.4",
    "serialize-javascript": "7.0.5",
    "tar": "7.5.13",
    "vite": "6.4.2"
  }
}
