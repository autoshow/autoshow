AUTOSHOW_MAX_CONCURRENT_USER_UPLOADS="12"
AUTOSHOW_MAX_CONCURRENT_GLOBAL_UPLOADS="256"
AUTOSHOW_UPLOAD_TTL_MS="86400000"
